{
  "name": "vn-cccd-scanner",
  "version": "0.1.0",
  "description": "Quét QR CCCD Việt Nam bằng webcam — thư viện frontend độc lập framework",
  "license": "MIT",
  "author": "kimthien128",
  "type": "module",
  "main": "./dist/vn-cccd-scanner.cjs",
  "module": "./dist/vn-cccd-scanner.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vn-cccd-scanner.js",
      "require": "./dist/vn-cccd-scanner.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
